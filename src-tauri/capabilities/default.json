{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "capture",
    "task-creation",
    "main"
  ],
  "permissions": [
    "existing-desktop-commands",
    "core:default",
    "sql:default",
    "sql:allow-execute",
    "store:default",
    "clipboard-manager:allow-write-text",
    "dialog:allow-save",
    "dialog:allow-open"
  ]
}
